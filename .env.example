NEXT_PUBLIC_SITE_URL="http://localhost:5173"
NEXT_PUBLIC_SITE_EMAIL="hello@example.com"

# Database
# For build optimization, add connection pooling parameters:
# ?connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://root@localhost/dirstarter"

# Cron Jobs
CRON_SECRET="xyz"

# BetterAuth
BETTER_AUTH_SECRET="xyz" # generate with `openssl rand -hex 32`
BETTER_AUTH_URL="http://localhost:5173"

# Google (sign-in). Optional: without it, the login form has no Google button.
# Production needs Resend or a social provider, since magic links need Resend to reach
# the inbox.
AUTH_GOOGLE_ID="placeholder.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="placeholder-google-secret"

# Redis (rate limiting and auth storage). Optional: without it, rate limiting falls back to memory.
# Format: redis://[username:password@]host:port
REDIS_URL=""

# AI (Vercel AI Gateway). Optional: without a key, the admin AI actions are off.
AI_GATEWAY_API_KEY=""
AI_CHAT_MODEL="anthropic/claude-sonnet-5.5"
AI_COMPLETION_MODEL="google/gemini-3.5-flash-lite"

# Jina (web scraping). Optional: without a key, scraping uses Jina's rate-limited free tier.
JINA_API_KEY=""

# ScreenshotOne (tool screenshots, stored on S3). Optional: without it, tools get no screenshot.
SCREENSHOTONE_ACCESS_KEY="placeholder-screenshotone-key"

# Resend (magic links and notification emails). Optional: without it, development logs
# emails and production refuses to send them, so production then needs a social provider,
# such as Google.
RESEND_API_KEY="re_placeholder"
RESEND_SENDER_EMAIL="noreply@mail.example.com"

# Highseat (analytics). Optional: without a site id the tracker is left out.
# Sign up at https://app.highseat.com/register?via=dirstarter for a 30-day trial.
# Site settings › Installation shows the site id, the proxy path and the site secret.
NEXT_PUBLIC_HIGHSEAT_SITE=""
# The site's first-party proxy path. `withHighseat()` in next.config.ts rewrites it to
# app/api/highseat at build time, so set it for the build as well as the server. Without
# it the build warns, leaves the rewrite out, and the tracker loads from Highseat's host.
HIGHSEAT_PATH=""
# Required with HIGHSEAT_PATH: without it the proxy answers 503 and no events arrive.
HIGHSEAT_SECRET=""
# A workspace API key, for the visitors chart in the admin dashboard.
HIGHSEAT_API_KEY=""

# Amazon S3 (favicons, screenshots and uploaded images). Optional: without it, favicons
# keep their external URL, screenshots are skipped and admin uploads are off.
S3_BUCKET="placeholder-bucket"
S3_REGION="us-east-1" # use "auto" for R2
S3_ACCESS_KEY="placeholder-access-key"
S3_SECRET_ACCESS_KEY="placeholder-secret-access-key"
S3_ENDPOINT="" # Optional. Cloudflare R2 endpoint, e.g. https://<acct>.r2.cloudflarestorage.com
S3_PUBLIC_URL="" # Optional. Public CDN base for uploaded media, e.g. https://cdn.dirstarter.com

# Stripe (paid listings). Optional: without it, submissions are free and the tier cards,
# checkout, billing portal and webhook are off.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Outbound webhooks (automation). Optional: without WEBHOOK_URL, no events are sent.
# WEBHOOK_URL receives domain events as POST requests (n8n, Zapier, Make).
# WEBHOOK_TOKEN is sent as a bearer header.
WEBHOOK_URL="" # e.g. https://n8n.example.com/webhook/dirstarter
WEBHOOK_TOKEN="" # Optional shared secret for the receiver to verify

# MCP server (AI agents). Optional: without it, /api/mcp is off.
# An agent sends MCP_SECRET as a bearer token and acts as the site's first admin account.
MCP_SECRET="" # generate with `openssl rand -hex 32`

# Trusted proxy (client IP). Optional: leave it unset on Vercel.
# Set to "cloudflare" when the site sits behind a proxied Cloudflare record with Traefik
# in front of the app (Dokploy). The client IP then comes from `cf-connecting-ip`, read
# only when the request arrived from a Cloudflare address. Unset, it is the last
# `x-forwarded-for` entry, which the proxy sets to the TCP peer. The same IP drives the
# app's rate limiter and better-auth's (sign-in, magic links), via `proxy.ts`.
TRUSTED_PROXY=""

# Revinel (ads). Optional: without a workspace id, the whole ad system stays off.
# Sign up with the ad fields pre-configured: https://app.revinel.com/auth/signup?ref=dirstarter
NEXT_PUBLIC_REVINEL_WORKSPACE_ID=""
NEXT_PUBLIC_REVINEL_API_URL="" # Optional. Defaults to https://api.revinel.com
NEXT_PUBLIC_REVINEL_APP_URL="" # Optional. Revinel app origin serving the /advertise tier selector
NEXT_PUBLIC_ADS_DISABLED="" # Optional. Set truthy to force ads off even with a workspace id
